# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
doc/api/

# Generated code is COMMITTED, not ignored — see CLAUDE.md §10.
# Do not add *.g.dart or *.freezed.dart here.
#
# pubspec.lock is COMMITTED too, and for the same reason: `just codegen-check`
# and `just mutants` must produce the same bytes on every machine, and they
# cannot if the resolved versions of freezed or mutation_test drift.

# Coverage / gate output
coverage/
*.lcov
lcov.info
.mutation-output/
mutation-test-report/

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# iOS
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/ephemeral/
**/ios/Pods/
# CocoaPods' resolved lockfile. `flutter build ios` writes it, and this repo has
# never committed it — so anyone who builds iOS before `just codegen-check`
# gets a diff failure with nothing to do with codegen. Ignored rather than
# committed because nothing in `just check` reads it and CI never runs a pod
# install; the day an iOS build joins CI, commit it instead and delete this.
**/ios/Podfile.lock
**/ios/.symlinks/
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/**/*.mode1v3
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/xcuserdata/

# Kotlin's incremental-compile session directory, written by the Android
# Gradle build and left behind as an untracked `*.salive` file mid-build.
**/.kotlin/

# Editors
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Local server fixtures / scratch (captured payloads live in test/fixtures/)
/scratch/
.mutation-survivors/

# A personal Apple team id is not committed: ios/Flutter/Local.xcconfig carries
# it, and Local.xcconfig.example says what to put there. Without the file the
# project builds unsigned, which is what CI wants.
**/ios/Flutter/Local.xcconfig
